# === LOCAL DEVELOPMENT (OAuth) ===
GOOGLE_OAUTH_FILE=client_secrets.json

# === SERVER/DOCKER DEPLOYMENT (Service Account) ===
# Paste the entire JSON content of your service account key:
# GOOGLE_SERVICE_ACCOUNT_JSON={"type": "service_account", "project_id": "...", ...}

# Your Google Spreadsheet ID (from the URL)
SPREADSHEET_ID=https://docs.google.com/spreadsheets/d/1kZuKg0KHtIkCM1o7iJk0AMCoPPv2sKD-N5NHA21_LNE/edit?usp=sharing

# Optional: specific worksheet name (defaults to first sheet)
WORKSHEET_NAME=TestCases
